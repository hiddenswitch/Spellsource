{
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "target": "ES5",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "ES2022"],
    "sourceMap": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "downlevelIteration": true,
    "declaration": true,
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {},
    "outDir": ".",
    "baseUrl": "..",
    "noEmit": false,
    "module": "CommonJS",
    "strict": false
  },
  "include": ["src/main/javascript/**/*", "build/compiled/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts", "dist/**/*"]
}
