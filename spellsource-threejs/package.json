    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "@apollo/client": "4.3.5",
    "@react-spring/three": "10.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "graphql": "16.14.2",
    "graphql-ws": "6.4.1",
    "rxjs": "7.8.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@graphql-codegen/add": "7.1.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@types/jest": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0",
    "jest": "^29.1.0",
    "ts-jest": "^29.1.0",
    "typescript": "5.9.3"
  }
