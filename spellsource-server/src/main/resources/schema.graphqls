# ─── Art types ────────────────────────────────────────────────

type ArtColor {
    r: Float!
    g: Float!
    b: Float!
    a: Float!
}

type ArtFont {
    vertex: ArtColor
}

type ArtPrefab {
    named: String
}

type ArtSprite {
    named: String
}

type Art {
    body: ArtFont
    highlight: ArtColor
    loop: ArtPrefab
    missile: ArtPrefab
    onCast: ArtPrefab
    onHit: ArtPrefab
    primary: ArtColor
    secondary: ArtColor
    shadow: ArtColor
    spell: ArtPrefab
    sprite: ArtSprite
    spriteShadow: ArtSprite
}

# ─── Core game entity types ──────────────────────────────────

type EntityLocation {
    index: Int!
    zone: Zone!
    player: Int!
}

type Tooltip {
    keywords: [String!]!
    text: String!
}

type Entity {
    id: Int!
    name: String!
    description: String!
    cardId: String!
    cardType: CardType!
    entityType: EntityType!
    rarity: Rarity!
    location: EntityLocation
    art: Art
    owner: Int!
    boardPosition: Int!

    # stats
    attack: Int
    baseAttack: Int
    hp: Int
    baseHp: Int
    maxHp: Int
    armor: Int
    manaCost: Int
    baseManaCost: Int
    durability: Int
    spellDamage: Int
    overload: Int
    extraAttack: Int

    # player resource fields
    mana: Int!
    maxMana: Int!
    lockedMana: Int!

    # boolean flags
    battlecry: Boolean!
    cannotAttack: Boolean!
    charge: Boolean!
    chooseOne: Boolean!
    collectible: Boolean!
    combo: Boolean!
    conditionMet: Boolean!
    deathrattles: Boolean!
    deflect: Boolean!
    destroyed: Boolean!
    discarded: Boolean!
    divineShield: Boolean!
    enraged: Boolean!
    frozen: Boolean!
    gameStarted: Boolean!
    gold: Boolean!
    hostsTrigger: Boolean!
    immune: Boolean!
    isStartingTurn: Boolean!
    lifesteal: Boolean!
    permanent: Boolean!
    playable: Boolean!
    poisonous: Boolean!
    roasted: Boolean!
    rush: Boolean!
    silenced: Boolean!
    stealth: Boolean!
    summoningSickness: Boolean!
    taunt: Boolean!
    uncensored: Boolean!
    underAura: Boolean!
    untargetableBySpells: Boolean!
    windfury: Boolean!

    # misc
    charges: Int
    countUntilCast: Int
    fires: Int
    host: Int!
    heroClasses: [String!]!
    cardSet: String!
    cardSets: [String!]!
    enchantmentType: String!
    tribes: [String!]!
    tooltips: [Tooltip!]!
    note: String!
}

# ─── Card catalogue ───────────────────────────────────────────

type CardRecord {
    id: BigInt!
    entity: Entity!
    cardId: String
    userId: String
    count: Int!
    collectionIds: [String!]!
}

type GetCardsResponse {
    cards: [CardRecord!]!
    version: String!
    cachedOk: Boolean!
}

# ─── Account / Auth types ─────────────────────────────────────

type UserEntity {
    id: String!
    email: String!
    username: String!
    privacyToken: String!
}

type AccessToken {
    token: String!
}

type LoginOrCreateReply {
    accessToken: AccessToken
    userEntity: UserEntity
}

type ClientConfiguration {
    keycloakResetPasswordUrl: String
    keycloakAccountManagementUrl: String
    graphQlUrl: String
}

type Friend {
    friendId: String!
    friendName: String!
    presence: Presence!
    since: BigInt!
}

# ─── Deck types ───────────────────────────────────────────────

type AttributeValueTuple {
    attribute: PlayerEntityAttribute!
    stringValue: String!
}

type ValidationReport {
    errors: [String!]!
    valid: Boolean!
}

type InventoryCollection {
    id: String!
    name: String!
    heroClass: String!
    format: String!
    deckType: DeckType!
    collectionType: CollectionType!
    userId: String
    isStandardDeck: Boolean!
    inventory: [CardRecord!]!
    playerEntityAttributes: [AttributeValueTuple!]!
    validationReport: ValidationReport
}

type DecksGetResponse {
    collection: InventoryCollection
    inventoryIdsSize: Int!
}

type DecksPutResponse {
    collection: InventoryCollection
    deckId: String!
}

# ─── Draft types ──────────────────────────────────────────────

type DraftState {
