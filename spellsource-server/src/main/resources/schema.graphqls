    heroClass: Boolean!
    deckIdChoices: [String!]!
}

type MatchmakingQueue {
    queueId: String!
    name: String!
    description: String!
    tooltip: String!
    requires: MatchmakingQueueRequires
}

type MatchFound {
    gameId: String!
    url: String!
    playerKey: String!
    playerSecret: String!
}

# ─── Game record types ────────────────────────────────────────

type GameRecord {
    completedAt: BigInt!
    completedAtLocalized: String
    isBotGame: Boolean!
    playerNames: [String!]!
}

# ─── Editable card types ─────────────────────────────────────

type EditableCard {
    id: String!
    ownerUserId: String!
    source: String!
}

type PutCardResult {
    cardId: String!
    editableCardId: String!
    cardScriptErrors: [String!]!
}

# ─── Game types (real-time game state) ────────────────────────

type TargetActionPair {
    action: Int!
    target: Int!
    friendlyBattlefieldIndex: Int!
}

type SpellAction {
    action: Int!
    actionType: ActionType!
    sourceId: Int!
    description: String!
    choices: [SpellAction!]!
    entity: Entity
    targetKeyToActions: [TargetActionPair!]!
}

type GameActions {
    all: [SpellAction!]!
    compatibility: [Int!]!
}

type GameOver {
    localPlayerWon: Boolean!
    winningPlayerId: Int
}

type Timers {
    millisRemaining: BigInt!
}

type GameState {
    entities: [Entity!]!
    isLocalPlayerTurn: Boolean!
    turnNumber: Int!
    turnState: String!
    timestamp: BigInt!
    powerHistory: [GameEvent!]
    hasPowerHistory: Boolean!
}

type Emote {
    entityId: Int!
    message: EmoteType!
}

type CardEvent {
    card: Entity
    showLocal: Boolean!
}

type GameEvent {
    eventType: GameEventType!
    id: Int!
    description: String!
    isPowerHistory: Boolean!
    isSourcePlayerLocal: Boolean!
    isTargetPlayerLocal: Boolean!
    source: Entity
    target: Entity
    targets: [Entity!]!
    value: Int
    cardEvent: CardEvent
    entityTouched: Int
    entityUntouched: Int
}

"""
A message from the server during a game. The messageType field indicates which
fields are populated. Clients should switch on messageType to process the message.
"""
type ServerGameMessage {
    messageType: MessageType!
    id: String
    localPlayerId: Int!
    isReplayMessage: Boolean!

    """Present on ON_UPDATE and ON_REQUEST_ACTION messages."""
    gameState: GameState

    """Present on ON_REQUEST_ACTION messages. The actions the player can take."""
    actions: GameActions

    """Present on ON_MULLIGAN messages. The starting cards to consider discarding."""
    startingCards: [Entity!]

    """Present on ON_GAME_EVENT messages."""
    event: GameEvent

    """Present on ON_GAME_END messages."""
    gameOver: GameOver

    """Present on EMOTE messages."""
    emote: Emote

    """Present on TIMER messages."""
    timers: Timers

    """
    IDs of entities that changed in this message. Present on ON_UPDATE and
    ON_REQUEST_ACTION messages. Clients use this to diff zones efficiently
    instead of comparing the full entity list.
    """
    changedEntityIds: [Int!]
}

# ─── Rogue types (existing) ──────────────────────────────────

type RogueRun {
    id: BigInt!
}

type RogueChoice {
    id: BigInt!
}

# ─── Input types ──────────────────────────────────────────────

input CreateAccountInput {
    email: String!
    username: String!
    password: String!
    decks: Boolean
    guest: Boolean
}

input LoginInput {
    usernameOrEmail: String!
    password: String!
}

input DecksPutInput {
    name: String!
    heroClass: String!
    format: String
    deckList: String
    cardIds: [String!]
}

input DecksUpdateInput {
    deckId: String!
    pullAllCardIds: [String!]
    pushCardIds: [String!]
    setHeroClass: String
    setName: String
    setPlayerEntityAttribute: AttributeValueInput
    unsetPlayerEntityAttribute: String
}

input AttributeValueInput {
    attribute: PlayerEntityAttribute!
    stringValue: String!
}

input DraftsPostInput {
    startDraft: Boolean
    retireEarly: Boolean
}

input InvitePostInput {
    toUserId: String
    toUserNameWithToken: String
    deckId: String
    queueId: String
    friend: Boolean
    message: String
}

input AcceptInviteInput {
    inviteId: String!
    deckId: String
    queueId: String
}

input MatchmakingEnqueueInput {
    deckId: String!
    queueId: String!
    botDeckId: String
}

input PutCardInput {
    editableCardId: String
    source: String!
    draw: Boolean
}

# ─── Query ────────────────────────────────────────────────────

type Query {
    # auth
    currentUserId: String
    configuration: ClientConfiguration!

    # cards
    cards(ifNoneMatch: String): GetCardsResponse!
    cardsByUser(ifNoneMatch: String): GetCardsResponse!

    # account
    account: UserEntity
    accounts(userIds: [String!]!): [UserEntity!]!

    # decks
    deck(deckId: String!): DecksGetResponse!
    decks: [DecksGetResponse!]!

    # drafts
    draft: DraftState!

    # friends (snapshot, use subscription for live updates)
    friends: [Friend!]!

    # invites
    invite(inviteId: String!): InviteResponse!
    invites: [Invite!]!

    # matchmaking
    matchmakingQueues: [MatchmakingQueue!]!
    isInMatch: String

    # game records
    gameRecord(gameId: String!): GameRecord
    gameRecordIds: [String!]!

    # rogue (existing)
    currentRogueClasses: [String!]!
    rerollCost(rogueId: BigInt!): Int!
    trashCardCost(rogueId: BigInt!, cardId: String!): Int!
    upgradeCardCost(rogueId: BigInt!, cardId: String!): Int!
}

# ─── Mutation ─────────────────────────────────────────────────

type Mutation {
    # auth
    createAccount(input: CreateAccountInput!): LoginOrCreateReply!
    login(input: LoginInput!): LoginOrCreateReply!
    changePassword(newPassword: String!): LoginOrCreateReply!
    requestPasswordResetEmail: Boolean!

    # decks
    createDeck(input: DecksPutInput!): DecksPutResponse!
    updateDeck(input: DecksUpdateInput!): DecksGetResponse!
    deleteDeck(deckId: String!): Boolean!
    duplicateDeck(deckId: String!): DecksGetResponse!

    # drafts
    startOrModifyDraft(input: DraftsPostInput!): DraftState!
    draftsChooseHero(heroIndex: Int!): DraftState!
    draftsChooseCard(cardIndex: Int!): DraftState!

    # friends
    addFriend(friendId: String, usernameWithToken: String): Friend!
    removeFriend(friendId: String!): Boolean!

    # invites
    sendInvite(input: InvitePostInput!): InviteResponse!
    acceptInvite(input: AcceptInviteInput!): InviteResponse!
    deleteInvite(inviteId: String!): InviteResponse!

    # matchmaking
    enqueueMatchmaking(input: MatchmakingEnqueueInput!): Boolean!
    cancelMatchmaking: Boolean!

    # game actions (send during an active game)
    """Connect to an active game. Must be called before gameMessages subscription will emit."""
    connectToGame(playerKey: String, playerSecret: String): Boolean!
    """Send a game action in response to an ON_REQUEST_ACTION message."""
    sendGameAction(actionIndex: Int!, repliesTo: String!): Boolean!
    """Send a mulligan response in response to an ON_MULLIGAN message."""
    sendMulligan(discardedCardIndices: [Int!]!, repliesTo: String!): Boolean!
    """Send an emote during a game."""
    sendEmote(entityId: Int!, message: EmoteType!): Boolean!
    """Concede the current game."""
    concedeGame: Boolean!
    """Notify the opponent that a local entity is being hovered."""
    touchEntity(entityId: Int!): Boolean!
    """Notify the opponent that a local entity is no longer being hovered."""
    untouchEntity(entityId: Int!): Boolean!

    # cards (editable)
    putCard(input: PutCardInput!): PutCardResult!
    deleteCard(editableCardId: String!): Boolean!

    # rogue (existing)
    startRogueRun(heroClass: String!, seed: BigInt): RogueRun!
    makeRogueChoice(choiceId: BigInt!, choices: [Int!]!): RogueRun!
    reroll(choiceId: BigInt!): RogueRun!
    trashCard(rogueId: BigInt!, cardId: String!): RogueRun!
    skipBoss(rogueId: BigInt!): RogueRun!
    upgradeCard(rogueId: BigInt!, cardId: String!): RogueRun!
}

# ─── Subscription ─────────────────────────────────────────────

type Subscription {
    """
    Streams game messages for the authenticated user's active game.
    Call connectToGame mutation first to initiate the game connection.
    Emits ServerGameMessage for each game state change, action request,
    mulligan, event, and game over.
    """
    gameMessages: ServerGameMessage!

    """Emits when the current user is matched into a game."""
    matchFound: MatchFound!

    """Emits friend list changes (added, removed, presence updates)."""
    friendUpdated: Friend!

    """Emits when an invite is received or its status changes."""
    inviteUpdated: Invite!

    """Emits when an editable card is added, changed, or removed."""
    editableCardUpdated: EditableCard!
}
